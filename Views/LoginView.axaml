<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="bacom.Views.LoginView">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <TextBlock Text="Not unlocked" FontFamily="Default" FontSize="36" FontWeight="Light" HorizontalAlignment="Center"/>
        <TextBlock Text="Not unlocked" FontSize="67" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <Separator Classes="separator" Width="0" Height="0"/>
        <Button Content="Unlock" Classes="primary" Width="110" Height="45" FontSize="18" Background="#007aff" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" Click="AuthUser"/>
        <Button Content="[Debug] Bypass Auth" Width="150" Height="30" FontSize="12" HorizontalAlignment="Center" Click="BypassAuth"/>
    </StackPanel>
</UserControl>