<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="bacom.Views.LoginView">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" MaxWidth="420" Margin="24">
        <TextBlock Text="Bacom" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="Your backup codes, encrypted on this Mac." TextWrapping="Wrap" TextAlignment="Center"/>
        <Button x:Name="UnlockButton" Content="Unlock vault" Classes="primary" Width="160" Height="45" FontSize="18" Background="#007aff" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" Click="AuthUser"/>
        <TextBlock x:Name="LoginStatus" Text="First time? Unlock to create your encrypted vault."
            TextWrapping="Wrap" TextAlignment="Center" Foreground="#A6A6AD"/>
        <Button x:Name="RestoreLoginButton" Content="Restore from backup" Click="RestoreFromBackup" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
